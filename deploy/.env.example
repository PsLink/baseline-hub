# Standalone Hub only. No upstream JWT or database credentials are shared.
HUB_DB_PASSWORD=
HUB_PUBLIC_URL=https://hub.example.com
HUB_PORT=8080
HUB_COOKIE_SECURE=true
# AutoTune origin, with its hub plugin enabled (do not append /api).
HUB_UPSTREAM_URL=http://172.28.4.5:30522
# Optional SSH SOCKS proxy; inside a container, use the host's reachable address.
# Example for Docker Desktop: socks5h://host.docker.internal:8991
HUB_UPSTREAM_PROXY=
HUB_GITHUB_CLIENT_ID=
HUB_GITHUB_CLIENT_SECRET=
# GitHub OAuth callback: https://hub.example.com/api/auth/github/callback
# Required for encrypted AutoTune session tokens; never commit its value.
HUB_CREDENTIAL_KEY=

# GitHub repository receiving reviewed Catalog pull requests.
HUB_CATALOG_REPOSITORY=PsLink/model-catalog
