FROM node:22-alpine AS build
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=$VITE_BASE_PATH
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
FROM nginx:1.27-alpine
ARG VITE_BASE_PATH=/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /tmp/hub-dist
RUN mkdir -p "/usr/share/nginx/html${VITE_BASE_PATH}" \
    && cp -a /tmp/hub-dist/. "/usr/share/nginx/html${VITE_BASE_PATH}" \
    && rm -rf /tmp/hub-dist \
    && sed -i "s|__BASE_PATH__|${VITE_BASE_PATH}|g" /etc/nginx/conf.d/default.conf
EXPOSE 80
